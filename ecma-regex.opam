opam-version: "2.0"
synopsis: "ECMAScript regular expressions for OCaml"
description: """
Library for ECMAScript regular-expression syntax and matching semantics
   for OCaml, including Unicode property escapes, raw UTF-16 ECMAScript String
   APIs, and JSON Schema regex compatibility evidence."""
maintainer: ["Yuriy Krasilnikov"]
authors: ["Yuriy Krasilnikov"]
license: "ISC"
homepage: "https://github.com/YuriyKrasilnikov/ocaml-ecma-regex"
bug-reports: "https://github.com/YuriyKrasilnikov/ocaml-ecma-regex/issues"
depends: [
  "dune" {>= "3.17"}
  "ocaml" {>= "5.1"}
  "alcotest" {with-test}
  "yojson" {with-test}
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
dev-repo: "git+https://github.com/YuriyKrasilnikov/ocaml-ecma-regex.git"
